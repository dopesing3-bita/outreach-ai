# ============================================================================
# Copy this file to `.env` for local development only. Never commit a real
# .env. On Render, set these as actual environment variables in the
# dashboard (Render does not read this file).
# ============================================================================

# ---- Gemini (Google AI Studio) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# ---- Snov.io (LinkedIn enrichment + email finder) ----
# Get these from your Snov.io account -> Settings -> API.
# NEVER exposed to the frontend — read only by server/snov.js.
SNOV_API_USER_ID=your-snov-user-id
SNOV_API_SECRET=your-snov-api-secret

# ---- Port ----
# Render injects PORT automatically. Defaults to 8080 if unset (local dev).
PORT=8080
